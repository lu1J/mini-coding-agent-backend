      "approval": { "flow": "none", "expected_pending_tool": null },
      "verify": [
        { "type": "tool_result_contains", "tool": ["get_python_file_outline"], "path_hint": "math_utils.py", "expect_success": true, "contains": ["[函数] multiply", "[函数] square"] },
        { "type": "file_unchanged", "path": "math_utils.py" }
      ]
    },
    {
      "id": "gv1_dependency_edges",
      "name": "分析正向依赖关系",
      "category": "dependency",
      "smoke": false,
      "max_steps": 8,
      "prompt_template": "请调用 get_python_dependencies 依次分析 {case_root}/api.py 和 {case_root}/service.py 的本地项目依赖，告诉我 api.py 依赖哪些本地文件、service.py 依赖哪些本地文件，并说明 models.py 是否被依赖。",
      "expected": {
        "allowed_statuses": ["finished"],
        "required_tools": ["get_python_dependencies"],
        "forbidden_tools": ["edit_file", "write_new_file", "ensure_gitignore"],
        "plan_completion_min": 1.0,
        "max_premature_final": 0,
        "executor_stalled_allowed": false,
        "auxiliary_answer_contains": ["service", "models"]
      },
      "approval": { "flow": "none", "expected_pending_tool": null },
      "verify": [
        { "type": "dependency_edge_present", "edges": [["api.py", "service.py"], ["service.py", "models.py"]] },
        { "type": "file_unchanged", "path": "api.py" },
        { "type": "file_unchanged", "path": "service.py" }
      ]
    },
    {
      "id": "gv1_modify_docstring_approve",
      "name": "修改 docstring 并批准",
      "category": "modify_approval",
      "smoke": true,
      "max_steps": 8,
      "prompt_template": "请先读取 {case_root}/math_utils.py 第 1 到 8 行确认当前内容，然后用 edit_file 把 multiply 函数的函数说明从“返回 a 和 b 的乘积”改成“返回两个数的乘积”。等待后端审批批准后继续完成总结。",
      "expected": {
        "allowed_statuses": ["finished"],
        "required_tools": ["edit_file"],
        "forbidden_tools": [],
        "plan_completion_min": 1.0,
        "max_premature_final": 0,
        "executor_stalled_allowed": false,
        "auxiliary_answer_contains": []
      },
      "approval": { "flow": "approve", "expected_pending_tool": "edit_file" },
      "verify": [
        { "type": "file_content_contains", "path": "math_utils.py", "contains": ["返回两个数的乘积"], "not_contains": ["返回 a 和 b 的乘积"] },
        { "type": "diff_presence", "path": "math_utils.py", "added_contains": ["返回两个数的乘积"], "removed_contains": ["返回 a 和 b 的乘积"] }
      ]
    },
