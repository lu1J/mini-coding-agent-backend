      "approval": { "flow": "approve", "expected_pending_tool": "write_new_file" },
      "verify": [
        { "type": "file_exists", "path": "eval_notes.txt" },
        { "type": "file_content_contains", "path": "eval_notes.txt", "contains": ["Mini Agent Eval golden dataset"], "not_contains": [] }
      ]
    },
    {
      "id": "gv1_modify_triple_pytest",
      "name": "新增函数并用 pytest 验证",
      "category": "modify_verify",
      "smoke": false,
      "max_steps": 10,
      "prompt_template": "请先读取 {case_root}/utils.py 前 10 行，然后用 edit_file 在该文件中添加新函数 triple(x)，函数说明为“返回入参 x 的三倍。”，函数体 return x * 3。等待后端审批批准后，用 run_command 执行 python -m pytest tests/ -q（cwd 为 {case_root}）确认所有测试通过。",
      "expected": {
        "allowed_statuses": ["finished"],
        "required_tools": ["edit_file", "run_command"],
        "forbidden_tools": [],
        "plan_completion_min": 1.0,
        "max_premature_final": 0,
        "executor_stalled_allowed": false,
        "auxiliary_answer_contains": ["passed", "通过"]
      },
      "approval": { "flow": "approve", "expected_pending_tool": "edit_file" },
      "verify": [
        { "type": "file_content_contains", "path": "utils.py", "contains": ["def triple(x)", "return x * 3"], "not_contains": [] },
        { "type": "command_output_contains", "tool": ["run_command"], "contains": ["passed"] }
      ]
    },
