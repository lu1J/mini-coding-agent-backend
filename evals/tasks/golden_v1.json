{
  "schema_version": 1,
  "created": "2026-09-05",
  "description": "Day19 Agent Eval 固定标准评测集（Golden Dataset）v1。共 16 个任务，全部确定性判分，不引入 LLM-as-judge。prompt 中的 {case_root} 会在运行时替换成隔离 fixture 的 workspace 相对路径（eval_cases/<run_id>/<task_id>/demo_project）。",
  "tasks": [
    {
      "id": "gv1_read_math_utils",
      "name": "读取 math_utils.py 并解释",
      "category": "read",
      "smoke": true,
      "max_steps": 6,
      "prompt_template": "请读取 {case_root}/math_utils.py 第 1 到 8 行，并解释 multiply 函数的作用。",
      "expected": {
        "allowed_statuses": ["finished"],
        "required_tools": ["read_file_lines"],
        "forbidden_tools": ["edit_file", "write_new_file", "ensure_gitignore"],
        "plan_completion_min": 1.0,
        "max_premature_final": 0,
        "executor_stalled_allowed": false,
        "auxiliary_answer_contains": ["multiply", "乘积"]
      },
      "approval": { "flow": "none", "expected_pending_tool": null },
      "verify": [
        { "type": "file_content_contains", "path": "math_utils.py", "contains": ["def multiply(a, b)"], "not_contains": [] },
        { "type": "file_unchanged", "path": "math_utils.py" }
      ]
    },
    {
      "id": "gv1_read_readme",
      "name": "读取 README.md 并说明",
      "category": "read",
      "smoke": false,
      "max_steps": 6,
      "prompt_template": "请读取 {case_root}/README.md 第 1 到 20 行，并说明这个目录是什么项目、Agent 会在这里执行哪些任务。",
      "expected": {
        "allowed_statuses": ["finished"],
        "required_tools": ["read_file_lines"],
        "forbidden_tools": ["edit_file", "write_new_file", "ensure_gitignore"],
        "plan_completion_min": 1.0,
        "max_premature_final": 0,
        "executor_stalled_allowed": false,
        "auxiliary_answer_contains": ["Demo Project", "示例"]
      },
      "approval": { "flow": "none", "expected_pending_tool": null },
      "verify": [
        { "type": "file_content_contains", "path": "README.md", "contains": ["Day19 Agent Eval 固定评测 fixture"], "not_contains": [] },
        { "type": "file_unchanged", "path": "README.md" }
      ]
    },
    {
      "id": "gv1_search_hello",
      "name": "搜索 hello 并读取上下文",
      "category": "search",
      "smoke": true,
      "max_steps": 8,
      "prompt_template": "请在 {case_root} 目录中用 search_code 搜索关键词 hello，然后读取 main.py 中命中行附近的代码，说明 /hello 接口返回什么内容。",
      "expected": {
        "allowed_statuses": ["finished"],
        "required_tools": ["search_code"],
        "forbidden_tools": ["edit_file", "write_new_file", "ensure_gitignore"],
        "plan_completion_min": 1.0,
        "max_premature_final": 0,
        "executor_stalled_allowed": false,
        "auxiliary_answer_contains": ["/hello", "Mini Agent Eval"]
      },
      "approval": { "flow": "none", "expected_pending_tool": null },
      "verify": [
        { "type": "file_unchanged", "path": "main.py" }
      ]
    },
    {
      "id": "gv1_structure_outline",
      "name": "生成 math_utils.py 结构大纲",
      "category": "structure",
      "smoke": false,
      "max_steps": 6,
      "prompt_template": "请调用 get_python_file_outline 分析 {case_root}/math_utils.py，列出其中的函数符号、类型和行号范围。",
      "expected": {
        "allowed_statuses": ["finished"],
        "required_tools": ["get_python_file_outline"],
